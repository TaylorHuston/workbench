{
  "name": "markdown-live-spike",
  "displayName": "Markdown Live Spike",
  "description": "A source-first live Markdown editor experiment",
  "version": "0.0.1",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:markdownLive.editor"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "markdownLive.editor",
        "displayName": "Markdown Live Spike",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/markdown": "^1.7.2",
    "codemirror-live-markdown": "0.5.1-alpha.1",
    "lowlight": "^3.3.0",
    "highlight.js": "^11.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
